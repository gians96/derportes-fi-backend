# Conexión a MariaDB externa (URL completa)
DATABASE_URL="mysql://usuario:password@host:3306/deportes_fi"

# Puerto del servidor
PORT=3001

# Origen(es) permitido(s) para CORS (separados por coma)
CORS_ORIGIN=http://localhost:3000

# JWT
JWT_SECRET=cambia-esta-clave-secreta
JWT_EXPIRES_IN=7d

# Google OAuth (mismo Client ID que el frontend)
GOOGLE_CLIENT_ID=

# Dominio institucional permitido
INSTITUTIONAL_DOMAIN=undc.edu.pe

# Endpoint del padrón académico
ACADEMIC_API_URL=https://sivireno.undc.edu.pe/tiger/consulta/con_searchEstudiante.php

# Consulta de DNI (Decolecta / RENIEC)
DECOLECTA_API_URL=https://api.decolecta.com/v1/reniec/dni
DECOLECTA_TOKEN=

# Directorio para archivos subidos (vouchers)
UPLOADS_DIR=uploads

# Cuentas con rol elevado (separadas por coma) - usadas al iniciar sesión
OWNER_EMAILS=
ADMIN_EMAILS=
